    "payledger"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "timepicker": {},
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Traces (Jaeger)",
      "type": "link",
      "url": "http://localhost:16686",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Search traces by service, or by the X-Trace-Id of a response"
    },
    {
      "title": "Alerts (Prometheus)",
      "type": "link",
      "url": "http://localhost:9090/alerts",
      "targetBlank": true,
      "icon": "external link",
