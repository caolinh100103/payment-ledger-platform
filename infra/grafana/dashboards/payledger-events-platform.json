        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (consumergroup, topic) (clamp_min(kafka_consumergroup_lag{topic!~\".*-(retry-[0-9]+|dlt)\"}, 0))",
          "legendFormat": "{{consumergroup}} · {{topic}}",
          "range": true,
          "instant": false,
