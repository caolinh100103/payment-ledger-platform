      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(payledger_outbox_delivery_delay_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
