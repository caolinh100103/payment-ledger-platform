    {
      "id": 11,
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "Messages waiting per consumer group and topic (kafka-exporter). Retry topics are left out: their messages wait out a back-off on purpose.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
