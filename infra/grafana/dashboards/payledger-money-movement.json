{
  "uid": "payledger-money-movement",
  "title": "PayLedger · Money movement",
  "description": "Business view of the core: what moved, what was rejected and why, how long it took, and contention.",
  "tags": [
    "payledger"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "timepicker": {},
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "currency",
        "label": "Currency",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(payledger_transfers_amount_total, currency)",
        "query": {
          "query": "label_values(payledger_transfers_amount_total, currency)",
          "refId": "currency"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "VND",
          "value": "VND"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
