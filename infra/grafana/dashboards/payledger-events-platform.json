  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Outbox backlog",
      "description": "Events committed but not yet acknowledged by Kafka. A backlog that drains is fine.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(payledger_outbox_pending)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "justifyMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Oldest unpublished",
      "description": "How long the oldest outbox event has waited. Alert: above 60 s for 2 minutes (Kafka down, relay stuck, or a poison event).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(payledger_outbox_oldest_pending_age_seconds)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 10
              },
              {
                "color": "#d03b3b",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "justifyMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Worst consumer lag",
      "description": "Most messages waiting for one consumer group on one topic, measured by kafka-exporter from committed offsets. Alert: above 1000 for 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(sum by (consumergroup, topic) (clamp_min(kafka_consumergroup_lag{topic!~\".*-(retry-[0-9]+|dlt)\"}, 0)))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 100
              },
              {
                "color": "#d03b3b",
                "value": 1000
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "justifyMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dead letters (24 h)",
      "description": "Events parked on a dead-letter topic: an audit gap or a missing customer message. Each needs a person.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(payledger_events_dead_lettered_total[24h])) or vector(0)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "justifyMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Limiter bypassed",
      "description": "Share of requests let through unchecked because Redis is unavailable (ADR 0012).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(payledger_rate_limit_requests_total{outcome=\"bypassed\"}[5m])) or vector(0)) / sum(rate(payledger_rate_limit_requests_total[5m]))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0.0001
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "justifyMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "showPercentChange": false
      }
    },
    {
