      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(payledger_lock_failures_total{reason=\"deadlock\"}[24h])) or vector(0)",
